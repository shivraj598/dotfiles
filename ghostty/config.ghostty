# --- Font Fixes for Spacing Glitches ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# Force Nerd Font icon codepoints to render from JetBrainsMono Nerd Font.
# Ghostty only auto-uses its embedded icons when the primary font lacks them
# AND the width hint matches; explicitly mapping the PUA ranges keeps the
# icons single-width and correctly scaled even when driven through tmux.
font-codepoint-map = U+E000-U+F8FF=JetBrainsMono Nerd Font

# --- Your Window Transparency Styles ---
# Controls window transparency (0.0 is fully clear, 1.0 is fully solid)
background-opacity = 0.20

# Adds a beautiful native macOS frosted glass blur behind the text
background-blur = true

# Tells other apps your native terminal type for perfect compatibility
term = "xterm-ghostty"

# --- Split Pane Dividers ---
# Red color for split divider lines (Cmd+D splits)
split-divider-color = #ff0000

# --- Split Pane Navigation ---
# Move focus between splits with Cmd+Shift+H/J/K/L (vim-style)
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
