# ==============================================================================
# Ghostty Configuration — Rose Pine
# Based on the pasted config. Keybindings from the pasted config are NOT applied
# (kept the current cmd+shift+goto_split binds below).
#
# Theme note: pasted `config-file = themes/rosepine` does not resolve
# (looked in ~/Library/Application Support/com.mitchellh.ghostty/themes/
#  -> FileNotFound). Fixed to `.config/themes/rosepine`, which resolves to
#  ~/dotfiles/ghostty/.config/themes/rosepine via the existing symlink.
# ==============================================================================

config-file = .config/themes/rosepine
background-opacity = 0.30
background-blur-radius = 25

font-family = JetBrainsMonoNL Nerd Font
font-size = 13
font-feature = -liga,-calt,-dlig

# Force Nerd Font PUA to single-width, correctly scaled through tmux
font-codepoint-map = U+E000-U+F8FF=JetBrainsMonoNL Nerd Font

cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

unfocused-split-opacity = 0.55
split-divider-color = #524f67

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false

# --- Background image (kept from previous config) ---
# background-image = ~/dotfiles/public/girl4.jpeg
background-image-fit = cover
background-image-position = center
background-image-opacity = .50

# --- Window glue (kept so status bar sits flush) ---
window-step-resize = true
window-padding-color = extend
window-save-state = never
window-show-tab-bar = never

# --- Terminal ---
term = "xterm-ghostty"

# --- Updates ---
auto-update = check
auto-update-channel = stable

# --- Extras ---
shell-integration-features = no-cursor
window-title-font-family = ""
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
scrollback-limit = 100000

# --- Shaders ---
# custom-shader = shaders/bettercrt.glsl
# custom-shader = shaders/retro-terminal.glsl

# --- Split Navigation (current keybindings; pasted ctrl+space keybinds ignored) ---
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right